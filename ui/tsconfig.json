{
    "compilerOptions": {
        "outDir": "../dist",
        "noImplicitAny": false,
        "module": "ES2020",
        "moduleResolution": "node",
        "target": "ES2020",
        "allowJs": true,
        "lib": [
            "ES2020",
            "DOM"
        ],
        "sourceMap": true,
        "removeComments": false,
        "skipLibCheck": true
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}